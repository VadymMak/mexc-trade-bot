# ── mexc-trade-bot researcher .env ───────────────────────────────────────────
# Скопируй в .env.paper или .env.live и заполни значения
# cp .env.example .env.paper && nano .env.paper

# ── Database ──────────────────────────────────────────────────────────────────
NEON_DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-tiny-sky-anbfr314.c-6.us-east-1.aws.neon.tech/neondb?sslmode=require

# ── Backend connection ────────────────────────────────────────────────────────
# VPS (оба сервиса на одном сервере):
TRADING_BOT_URL=http://localhost:8000
TRADING_BOT_URL_INTERNAL=http://localhost:8000
# Railway (пока не мигрировали):
# TRADING_BOT_URL=https://mexc-trade-bot-production.up.railway.app
# TRADING_BOT_URL_INTERNAL=http://backend.railway.internal:8000

# ── Trading mode ──────────────────────────────────────────────────────────────
LIVE_TRADING=false           # true для live, false для paper

# ── Capital & compounding ─────────────────────────────────────────────────────
STARTING_EQUITY_USDT=600
COMPOUND_ENABLED=true
COMPOUND_MAX_MULT=5.0

# ── Position sizing ───────────────────────────────────────────────────────────
PAPER_DEAL_SIZE_USDT=10.0
DEAL_SIZE_MED_USDT=20.0
DEAL_SIZE_HIGH_USDT=30.0
MAX_EXPOSURE_USDT=150.0
MAX_OPEN_POSITIONS=8

# ── Strategy ──────────────────────────────────────────────────────────────────
ZSCORE_THRESHOLD=2.0
MIN_SPREAD_PCT=0.005
TAKE_PROFIT_RATIO=0.50
STOP_LOSS_RATIO=1.5
MAX_HOLD_SECONDS=14400
FUNDING_BLACKOUT_SECONDS=300
ZSCORE_REVERT_MIN_HOLD_SECONDS=120
MIN_SPREAD_CV=1.0
MAX_SPREAD_PCT=50.0

# ── Collectors ────────────────────────────────────────────────────────────────
ENABLED_COLLECTORS=gate,mexc
TRADING_EXCHANGES=gate,mexc

# ── Exchange API keys (только для LIVE_TRADING=true) ──────────────────────────
GATE_FUTURES_API_KEY=
GATE_FUTURES_SECRET=
MEXC_FUTURES_API_KEY=
MEXC_FUTURES_SECRET=

# ── Blacklisted symbols ───────────────────────────────────────────────────────
BLACKLISTED_SYMBOLS=ENJ_USDT,BLUR_USDT,ONT_USDT,DRIFT_USDT,ONG_USDT,SIREN_USDT,STO_USDT,NOM_USDT,CHILLGUY_USDT

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
SCALP_ENABLED=false
